<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SoporteTecnicoEquipos.EquiposPage"
             Title="Equipos">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="12">

            <Label
                Text="Registrar equipo"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label Text="Nombre del equipo" FontAttributes="Bold" />
            <Entry
                x:Name="NombreEntry"
                Placeholder="Ej. Computadora de escritorio" />

            <Label Text="Tipo" FontAttributes="Bold" />
            <Entry
                x:Name="TipoEntry"
                Placeholder="Ej. Laptop o impresora" />

            <Label Text="Marca" FontAttributes="Bold" />
            <Entry
                x:Name="MarcaEntry"
                Placeholder="Ej. HP, Dell o Lenovo" />

            <Label Text="Modelo" FontAttributes="Bold" />
            <Entry
                x:Name="ModeloEntry"
                Placeholder="Modelo del equipo" />

            <Button
                Text="Guardar equipo"
                HeightRequest="50"
                Clicked="OnGuardarEquipoClicked" />

            <Label
                Text="Equipos registrados"
                FontSize="22"
                FontAttributes="Bold"
                Margin="0,15,0,0" />

            <CollectionView x:Name="EquiposCollectionView">
                <CollectionView.EmptyView>
                    <Label
                        Text="Todavía no hay equipos registrados."
                        Padding="10"
                        HorizontalOptions="Center" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="15" Margin="0,5" CornerRadius="10">
                            <VerticalStackLayout Spacing="6">
                                <Label
                                    Text="{Binding Nombre}"
                                    FontSize="18"
                                    FontAttributes="Bold" />
                                <Label Text="{Binding Tipo, StringFormat='Tipo: {0}'}" />
                                <Label Text="{Binding Marca, StringFormat='Marca: {0}'}" />
                                <Label Text="{Binding Modelo, StringFormat='Modelo: {0}'}" />
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

