<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SoporteTecnicoEquipos.ListadoPage"
             Title="Listado de reportes">

    <VerticalStackLayout Padding="20" Spacing="15">

        <Label
            Text="Reportes de soporte"
            FontSize="28"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <CollectionView
            x:Name="ReportesCollectionView"
            VerticalOptions="FillAndExpand">

            <CollectionView.EmptyView>
                <Label
                    Text="No hay reportes registrados."
                    FontSize="18"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="15" Margin="0,5" CornerRadius="10">
                        <VerticalStackLayout Spacing="8">

                            <Label
                                Text="Reporte"
                                FontSize="20"
                                FontAttributes="Bold" />

                            <Label Text="{Binding Id}" />

                            <Label Text="Equipo:" FontAttributes="Bold" />
                            <Label Text="{Binding Equipo}" />

                            <Label Text="Problema:" FontAttributes="Bold" />
                            <Label Text="{Binding Problema}" />

                            <Label Text="Descripción:" FontAttributes="Bold" />
                            <Label Text="{Binding Descripcion}" />

                            <Label Text="Estado:" FontAttributes="Bold" />
                            <Label Text="{Binding Estado}" />

                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <Button
            Text="Crear reporte"
            HeightRequest="50"
            Clicked="OnCrearReporteClicked" />

    </VerticalStackLayout>

</ContentPage>
