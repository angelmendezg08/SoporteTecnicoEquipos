<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SoporteTecnicoEquipos.MainPage"
             Title="Iniciar sesión">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="20"
            VerticalOptions="Center">

            <Label
                Text="Soporte Técnico"
                FontSize="32"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                Text="Equipos Informáticos"
                FontSize="18"
                HorizontalOptions="Center"
                Margin="0,-10,0,20" />

            <Label
                Text="Correo electrónico"
                FontAttributes="Bold" />

            <Entry
                x:Name="EmailEntry"
                Placeholder="Ingrese su correo"
                Keyboard="Email" />

            <Label
                Text="Contraseña"
                FontAttributes="Bold"
                Margin="0,10,0,0" />

            <Entry
                x:Name="PasswordEntry"
                Placeholder="Ingrese su contraseña"
                IsPassword="True" />

            <Button
   
                 Text="Iniciar sesión"
                 HeightRequest="50"
                 Margin="0,15,0,0"
                 Clicked="OnLoginClicked" />

            <Label
                Text="Sistema de soporte técnico"
                FontSize="13"
                HorizontalOptions="Center"
                Margin="0,20,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
