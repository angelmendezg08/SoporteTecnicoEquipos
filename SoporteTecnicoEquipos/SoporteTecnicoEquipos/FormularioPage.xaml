<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SoporteTecnicoEquipos.FormularioPage"
             Title="Crear reporte">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="15">

            <Label
                Text="Crear reporte"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                Margin="0,10,0,15" />

            <Label Text="Equipo" FontAttributes="Bold" />

            <Entry
                x:Name="EquipoEntry"
                Placeholder="Nombre del equipo" />

            <Label Text="Problema" FontAttributes="Bold" />

            <Entry
                x:Name="ProblemaEntry"
                Placeholder="Descripción breve del problema" />

            <Label Text="Descripción" FontAttributes="Bold" />

            <Editor
                x:Name="DescripcionEditor"
                Placeholder="Describa detalladamente el problema"
                HeightRequest="120" />

            <Label Text="Estado" FontAttributes="Bold" />

            <Picker
                x:Name="EstadoPicker"
                Title="Seleccione el estado">
                <Picker.Items>
                    <x:String>Pendiente</x:String>
                    <x:String>En proceso</x:String>
                    <x:String>Resuelto</x:String>
                </Picker.Items>
            </Picker>

            <Button
                Text="Guardar reporte"
                HeightRequest="50"
                Margin="0,15,0,0"
                Clicked="OnGuardarReporteClicked" />

            <Button
                Text="Cancelar"
                HeightRequest="50"
                Clicked="OnCancelarClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
