<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SoporteTecnicoEquipos.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SoporteTecnicoEquipos"
    FlyoutBehavior="Disabled">

    <ShellContent
        Title="Iniciar sesión"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage"
        FlyoutItemIsVisible="False" />

    <ShellContent
        Title="Principal"
        ContentTemplate="{DataTemplate local:PrincipalPage}"
        Route="PrincipalPage" />

    <ShellContent
        Title="Reportes"
        ContentTemplate="{DataTemplate local:ListadoPage}"
        Route="ListadoPage" />

    <ShellContent
        Title="Formulario de reportes"
        ContentTemplate="{DataTemplate local:FormularioPage}"
        Route="FormularioPage" />

    <ShellContent
        Title="Equipos"
        ContentTemplate="{DataTemplate local:EquiposPage}"
        Route="EquiposPage" />

    <ShellContent
        Title="Clientes"
        ContentTemplate="{DataTemplate local:ClientesPage}"
        Route="ClientesPage" />

    <ShellContent
        Title="Técnicos"
        ContentTemplate="{DataTemplate local:TecnicosPage}"
        Route="TecnicosPage" />

    <MenuItem
        Text="Cerrar sesión"
        Clicked="OnLogoutClicked" />

</Shell>
